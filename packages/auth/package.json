{
  "name": "@auction/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./magic-link-callback": {
      "types": "./dist/magic-link-callback.d.ts",
      "default": "./dist/magic-link-callback.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./timings": {
      "types": "./dist/auth-timings.d.ts",
      "default": "./dist/auth-timings.js"
    },
    "./token-verifier": {
      "types": "./dist/middleware.d.ts",
      "default": "./dist/middleware.js"
    },
    "./session-credential": {
      "types": "./dist/session-credential.d.ts",
      "default": "./dist/session-credential.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-hosted-assets.mjs && mkdir -p dist/hosted-auth/assets && cp src/hosted-auth/assets/lax-shop-logo.svg dist/hosted-auth/assets/lax-shop-logo.svg",
    "build:hosted-assets": "node scripts/build-hosted-assets.mjs",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@auction/identity-contracts": "workspace:^",
    "@better-auth/utils": "0.4.2",
    "better-auth": "1.6.22",
    "jose": "^6.2.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@auction/config-ts": "workspace:*",
    "@types/node": "^22.10.5",
    "esbuild": "^0.25.12",
    "react": "^19.2.5",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  }
}

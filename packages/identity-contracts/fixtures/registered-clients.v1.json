{
  "clientIds": [
    "lax-account-web",
    "lax-art-web",
    "lax-bid-web",
    "lax-shop-web",
    "lax-shop-admin",
    "ws-mobile"
  ],
  "artWeb": {
    "allowedResources": ["lax-shop-api"],
    "allowedScopes": [
      "openid",
      "profile",
      "email",
      "offline_access",
      "phone",
      "shop.read",
      "shop.write"
    ],
    "backchannelLogoutUri": "https://lax.art/api/auth/backchannel-logout"
  },
  "bidWeb": {
    "allowedResources": ["lax-bid-api", "lax-ws"],
    "allowedScopes": ["openid", "profile", "email", "offline_access", "bid.read", "bid.write"],
    "backchannelLogoutUri": "https://lax.bid/api/auth/backchannel-logout"
  },
  "shopAdmin": {
    "allowedResources": ["lax-shop-api"],
    "allowedScopes": ["openid", "profile", "email", "offline_access", "shop.admin"],
    "backchannelLogoutUri": "https://admin.shop.lax.art/api/auth/backchannel-logout"
  },
  "shopWeb": {
    "allowedResources": ["lax-shop-api"],
    "allowedScopes": [
      "openid",
      "profile",
      "email",
      "offline_access",
      "phone",
      "shop.read",
      "shop.write"
    ],
    "backchannelLogoutUri": "https://shop.lax.art/api/auth/backchannel-logout"
  },
  "wsMobile": {
    "allowedResources": ["lax-ws"],
    "allowedScopes": ["openid", "profile", "email", "offline_access", "bid.read"]
  }
}

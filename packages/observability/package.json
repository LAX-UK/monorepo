{
  "name": "@auction/observability",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sentry-init-options": {
      "types": "./dist/sentry-init-options.d.ts",
      "default": "./dist/sentry-init-options.js"
    },
    "./sentry-shared": {
      "types": "./dist/sentry-shared.d.ts",
      "default": "./dist/sentry-shared.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sentry/core": "^10.51.0",
    "@sentry/node": "^10.51.0"
  },
  "devDependencies": {
    "@auction/config-ts": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

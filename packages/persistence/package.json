{
  "name": "@auction/persistence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "default": "./dist/interfaces/index.js"
    },
    "./repositories": {
      "types": "./dist/repositories/index.d.ts",
      "default": "./dist/repositories/index.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@auction/db": "workspace:*",
    "@auction/exports": "workspace:*",
    "@auction/types": "workspace:*",
    "@auction/validators": "workspace:*",
    "drizzle-orm": "^0.41.0"
  },
  "devDependencies": {
    "@auction/config-ts": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

{
  "name": "@auction/branding",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./brand-primitives.css": "./public/brand-primitives.css",
    "./lax-system.css": "./public/lax-system.css",
    "./favicons/*": "./public/favicons/*",
    "./images/*": "./public/images/*",
    "./lax-logo.svg": "./public/lax-logo.svg",
    "./lockups/*": "./public/lockups/*"
  },
  "scripts": {
    "generate:lockups": "pnpm exec tsx scripts/generate-lockup-assets.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@auction/config-ts": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

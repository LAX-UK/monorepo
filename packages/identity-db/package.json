{
  "name": "@auction/identity-db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./schema/auth": {
      "types": "./dist/schema/auth.d.ts",
      "default": "./dist/schema/auth.js"
    },
    "./schema/oauth": {
      "types": "./dist/schema/oauth.d.ts",
      "default": "./dist/schema/oauth.js"
    },
    "./schema/jwks-key": {
      "types": "./dist/schema/jwks-key.d.ts",
      "default": "./dist/schema/jwks-key.js"
    },
    "./schema/ssf": {
      "types": "./dist/schema/ssf.d.ts",
      "default": "./dist/schema/ssf.js"
    },
    "./schema/outbox": {
      "types": "./dist/schema/outbox.d.ts",
      "default": "./dist/schema/outbox.js"
    },
    "./pg": {
      "types": "./dist/pg/ssl.d.ts",
      "default": "./dist/pg/ssl.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@auction/identity-contracts": "workspace:^",
    "better-auth": "1.6.22",
    "pg": "^8.13.1"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@auction/config-ts": "workspace:*",
    "@types/pg": "^8.11.10",
    "drizzle-orm": "^0.45.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  }
}

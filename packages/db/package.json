{
  "name": "@auction/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:auth-role-contract": "vitest run src/auth-app-role.contract.test.ts src/auth-schema-grants.contract.test.ts src/identity-field-ownership.contract.test.ts",
    "test:api-role-contract": "vitest run src/api-app-role.contract.test.ts src/bid-profile-legacy-sync.contract.test.ts",
    "test:shop-role-contract": "vitest run src/shop-app-role.contract.test.ts",
    "test:worker-role-contract": "vitest run src/worker-app-role.contract.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:migrate:prod": "tsx src/migrate-prod.ts",
    "db:roles": "tsx src/migrate-roles.ts",
    "db:configure-oidc-clients": "tsx src/scripts/configure-oidc-clients.ts",
    "db:verify-migration-pair": "tsx src/scripts/verify-migration-pair.ts",
    "db:migrate:kit": "drizzle-kit migrate",
    "db:seed:dev": "tsx src/seed/runners/cli.ts --env=dev",
    "db:studio": "drizzle-kit studio",
    "db:report-email-collisions": "tsx scripts/report-email-collisions.ts",
    "db:backfill-auth-at-rest": "tsx scripts/backfill-auth-at-rest.ts",
    "db:backfill-lot-lifecycle-snapshot": "tsx src/scripts/backfill-lot-lifecycle-snapshot.ts",
    "db:backfill-user-mobile-e164": "tsx src/scripts/backfill-user-mobile-e164.ts",
    "db:backfill-user-registered-events": "tsx src/scripts/backfill-user-registered-events.ts",
    "db:reconcile-identity-profiles": "tsx src/scripts/reconcile-identity-profile-drift.ts",
    "db:backfill-bid-milestone-events": "tsx src/scripts/backfill-bid-milestone-events.ts",
    "db:backfill-qr-code": "tsx src/scripts/backfill-qr-code.ts",
    "db:seed:press-demo": "tsx scripts/seed-press-hub-demo.ts"
  },
  "dependencies": {
    "@auction/identity-db": "workspace:*",
    "@auction/identity-contracts": "workspace:*",
    "@auction/types": "workspace:*",
    "@auction/validators": "workspace:*",
    "@better-auth/utils": "0.4.0",
    "drizzle-orm": "^0.41.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@auction/config-ts": "workspace:*",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

# Root / shared — copy to .env and adjust (apps read their own vars via process.env)

# Database (PostgreSQL)
# Compose publishes Postgres to the host. If `pnpm db:migrate` fails with password errors but
# `docker compose exec postgres psql -U postgres -d auction` works, another server is bound to
# your host port — set POSTGRES_PUBLISH_PORT=5433 below and match DATABASE_URL's port.
# POSTGRES_PUBLISH_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auction
# Production role split (optional locally; required in DO App Platform after P1.1)
# DATABASE_URL_OWNER=postgresql://auction_owner:owner-password@host:5432/auction
# DATABASE_URL_AUTH=postgresql://auth_app:auth-password@host:5432/auction
# DATABASE_URL_API=postgresql://api_app:api-password@host:5432/auction
# DATABASE_URL_SHOP=postgresql://shop_app:shop-password@host:5432/auction
# DATABASE_URL_WORKER=postgresql://worker_app:worker-password@host:5432/auction
# AUTH_APP_DB_PASSWORD=
# API_APP_DB_PASSWORD=
# SHOP_APP_DB_PASSWORD=
# WORKER_APP_DB_PASSWORD=

# Redis (cache, pub/sub for real-time)
REDIS_URL=redis://127.0.0.1:6379

# API (apps/api)
PORT=3001
API_PUBLIC_URL=http://localhost:3001
OIDC_ISSUER_URL=http://localhost:3003
# Optional private back-channel URL when the canonical issuer is not internally routable.
# OIDC_INTERNAL_BASE_URL=http://auth:3003
JWT_AUDIENCE=lax-bid-api
# Temporary migration-only compatibility; keep false unless telemetry is monitored.
ALLOW_LEGACY_LAX_API_AUDIENCE=false
WEB_ORIGIN=http://localhost:3000
# Legal entity named on Bid records in the cross-product portfolio (defaults to @auction/branding).
# LAX_BID_LEGAL_NAME=London Auction Xchange LTD
SHOP_ORIGIN=http://localhost:3020
LAX_ART_ORIGIN=http://localhost:3050
# Issuer-hosted login is email-first (Bid parity). Set false for a combined email/password form.
# HOSTED_AUTH_EMAIL_FIRST=false
# Cross-product wayfinding (validated in @auction/lax-ecosystem). Local dev falls back to these ports;
# a running production server has no fallback, so set all three on Bid (web), Shop and Art or the
# unset product is left out of the product bar and footer.
LAX_BID_PUBLIC_URL=http://localhost:3000
LAX_SHOP_STOREFRONT_URL=http://localhost:3020
LAX_ART_PUBLIC_URL=http://localhost:3050
# Shop Admin origin for the post-invitation launch page in apps/web (falls back to the storefront).
LAX_SHOP_ADMIN_URL=http://localhost:3030
# Optional extra browser origins for API CORS (comma-separated). Replaces WEB_ORIGIN when set.
# Include the web app and event microsite if you bypass the event Vite proxy (e.g. direct API calls from :3003):
# WEB_ORIGINS=http://localhost:3000,http://localhost:3003
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-16-chars
# Separate API-owned HMAC key for email-change and onsite-event pass tokens.
CHECK_IN_TOKEN_SECRET=replace-with-a-separate-api-token-secret
# WEB_ORIGINS=https://lax.bid,https://api.lax.bid,https://auth.lax.bid,https://ws.lax.bid,https://event.lax.bid
# EVENT_ORIGIN=https://event.lax.bid
# Social login (optional locally). See docs/security/social-login-setup.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple uses the Services ID as APPLE_CLIENT_ID. Generate APPLE_CLIENT_SECRET with:
# APPLE_TEAM_ID=... APPLE_KEY_ID=... APPLE_CLIENT_ID=... APPLE_PRIVATE_KEY='...' pnpm gen:apple-secret
# Rotate APPLE_CLIENT_SECRET at least every 180 days.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Paste Apple's domain association file content here for apps/auth to serve at:
# /.well-known/apple-developer-domain-association.txt
APPLE_DOMAIN_ASSOCIATION=

# API / auth hardening
# VERIFY_ORIGIN=true requires Origin/Referer to match WEB_ORIGIN for mutating requests (excludes /api/auth)
VERIFY_ORIGIN=false
# Local HTTP cookies for apps/auth on localhost. Must stay false in production.
ALLOW_HTTP_COOKIES=true
# Optional comma-separated extra origins for SSR server actions (when internal host differs from WEB_ORIGIN)
# SSR_TRUSTED_ORIGINS=
# Trust forwarded client IPs only from these exact proxy addresses/CIDRs. Empty means ignore them.
# AUTH_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Trust CF-Connecting-IP only when DO-Connecting-IP belongs to one of these Cloudflare CIDRs.
# AUTH_TRUSTED_CLOUDFLARE_PROXY_CIDRS=
# Temporary staging-only raw forwarding-header diagnostics. Never enable in production.
# AUTH_CLIENT_IP_DIAGNOSTICS=false
# AUTH_DEK_KEY — 32-byte envelope-encryption key for OAuth tokens + 2FA secrets at rest.
#   Required in NODE_ENV=production. NEVER rotate without running the re-encryption backfill first.
#   Generate: openssl rand -hex 32   (gives 64-char hex string)
#   Or base64: openssl rand -base64 32  (gives 44-char base64url string)
# AUTH_DEK_KEY=
# Machine client used for privileged Identity lifecycle operations.
IDENTITY_MACHINE_CLIENT_ID=api-service
IDENTITY_MACHINE_CLIENT_SECRET=replace-with-a-shared-machine-secret-32-chars
# Credentials for the "download my data" routes only (scope subject_export); not the pair above.
IDENTITY_SUBJECT_EXPORT_CLIENT_ID=subject-export
IDENTITY_SUBJECT_EXPORT_CLIENT_SECRET=replace-with-a-separate-export-secret-32-chars
# Moving originals between lax.art and LAX Bid. The same pair on Bid's API and shop-api, and each
# one's address for the other (SHOP_API_INTERNAL_URL on Bid, BID_API_INTERNAL_URL on shop-api).
# Leave unset to keep the move switched off.
# INVENTORY_MACHINE_CLIENT_ID=inventory-move
# INVENTORY_MACHINE_CLIENT_SECRET=replace-with-a-separate-inventory-secret-32-chars
# SHOP_API_INTERNAL_URL=http://localhost:3280
# BID_API_INTERNAL_URL=http://localhost:3180
# Staff-assisted email change (scope staff_email_change), a credential of its own. Bid's API
# presents IDENTITY_STAFF_EMAIL_CHANGE_CLIENT_ID/_SECRET and Identity checks
# STAFF_EMAIL_CHANGE_MACHINE_CLIENT_ID/_SECRET: the same pair, different from every other machine
# client. Set both ends or neither; with neither, the change is unavailable.
# IDENTITY_STAFF_EMAIL_CHANGE_CLIENT_ID=staff-email-change
# IDENTITY_STAFF_EMAIL_CHANGE_CLIENT_SECRET=replace-with-a-separate-staff-email-secret-32-chars
# STAFF_EMAIL_CHANGE_MACHINE_CLIENT_ID=staff-email-change
# STAFF_EMAIL_CHANGE_MACHINE_CLIENT_SECRET=replace-with-a-separate-staff-email-secret-32-chars
# Saved addresses: `identity` serves the LAX-wide address book (old Bid table as read fallback),
# `legacy` rolls back to the Bid table alone. Use `identity` once the address backfill has run.
# ADDRESS_BOOK_SOURCE=identity
# Internal API target used by apps/auth to persist email intents in the product outbox.
API_INTERNAL_BASE_URL=http://127.0.0.1:3001
IDENTITY_EMAIL_ENQUEUE_TIMEOUT_MS=3000
IDENTITY_SUBJECT_USAGE_TIMEOUT_MS=1500
# Internal base URL of shop-api (it shares the machine client above). Account deletion asks
# LAX Bid and shop-api what a person has in flight; with this unset deletion is blocked, because
# a product that cannot be asked never counts as "nothing in the way".
SHOP_API_INTERNAL_BASE_URL=http://127.0.0.1:3011
IDENTITY_DELETION_ELIGIBILITY_TIMEOUT_MS=3000
# "Download my data". The worker reports progress to Identity with its own machine credential
# (scope subject_export), separate from the lifecycle credential above: set both or neither, and
# use a different client id. With neither, the progress route is not mounted.
# SUBJECT_EXPORT_MACHINE_CLIENT_ID=subject-export-worker
# SUBJECT_EXPORT_MACHINE_CLIENT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
# Staff "Data requests" (Bid admin > Compliance). Bid's API reads and acts on requests through
# Identity with its own machine credential (scope data_requests.staff), separate from the
# lifecycle and export credentials above. The same pair is set on apps/auth (checks it) and
# apps/api (uses it): set both or neither, and use a client id that differs from the other two.
# With neither on apps/auth the routes are not mounted; without it on apps/api they answer 503.
# DATA_REQUESTS_MACHINE_CLIENT_ID=bid-data-requests
# DATA_REQUESTS_MACHINE_CLIENT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
# IDENTITY_DATA_REQUESTS_CLIENT_ID=bid-data-requests
# IDENTITY_DATA_REQUESTS_CLIENT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
# Days after a manual data request closes before the person's contact name and details are
# cleared (apps/auth). The dates, scope, outcome and audit stay. 730 (two years) is a working
# figure: lawyer to confirm.
# DATA_REQUEST_CONTACT_RETENTION_DAYS=730
# The private bucket that holds personal data copies. Identity only signs 5-minute reads, so give
# it read-only keys; the worker writes and deletes with its own credentials. All four or none:
# without them requests still work and downloads answer 503. The bucket itself, its 8-day
# lifecycle rule and the credentials are infrastructure and are created with the worker job.
# SUBJECT_EXPORT_BUCKET=
# SUBJECT_EXPORT_REGION=
# SUBJECT_EXPORT_ENDPOINT=
# SUBJECT_EXPORT_READ_ACCESS_KEY_ID=
# SUBJECT_EXPORT_READ_SECRET_ACCESS_KEY=
# --- "Download my data": the worker (apps/worker) assembles the ZIP ---
# Set ALL of these on the worker or none (the worker refuses a partial set). With none, requests
# wait in the subject-data-export queue and nothing is collected. See docs/runbooks/subject-data-export.md.
# Where the worker reaches Identity (private URL where there is one) and shop-api. Bid is
# API_INTERNAL_BASE_URL above.
# IDENTITY_INTERNAL_BASE_URL=http://127.0.0.1:3003
# SHOP_API_INTERNAL_BASE_URL=http://127.0.0.1:3011
# The worker's OAuth client for Identity: the same pair as SUBJECT_EXPORT_MACHINE_CLIENT_ID/_SECRET on apps/auth.
# SUBJECT_EXPORT_MACHINE_CLIENT_ID=subject-export-worker
# SUBJECT_EXPORT_MACHINE_CLIENT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
# The pair Bid and shop-api check (IDENTITY_SUBJECT_EXPORT_CLIENT_ID/_SECRET above), so the worker
# needs the same two values.
# IDENTITY_SUBJECT_EXPORT_CLIENT_ID=subject-export
# IDENTITY_SUBJECT_EXPORT_CLIENT_SECRET=replace-with-a-separate-export-secret-32-chars
# The same private bucket as SUBJECT_EXPORT_BUCKET on apps/auth, with write and delete keys. The
# worker writes; Identity only signs reads with its own read-only keys.
# SUBJECT_EXPORT_BUCKET=
# SUBJECT_EXPORT_REGION=
# SUBJECT_EXPORT_ENDPOINT=
# SUBJECT_EXPORT_WRITE_ACCESS_KEY_ID=
# SUBJECT_EXPORT_WRITE_SECRET_ACCESS_KEY=
# Keep false until every product has completed its subject-merge preflight.
IDENTITY_MERGE_ENABLED=false
# Passkeys on the auth issuer (sign in with a passkey, add one from LAX Account). Off until the
# hosted pages for them ship. The relying party is always OIDC_ISSUER_URL's own host.
PASSKEYS_ENABLED=false
# OpenID SSF/CAEP push is opt-in. Registered Bid/Shop streams remain disabled otherwise.
SSF_DELIVERY_ENABLED=false
SSF_DELIVERY_TIMEOUT_MS=5000
SSF_DELIVERY_MAX_ATTEMPTS=8
# Cloudflare Turnstile — bot-protection widget on sign-in, register, forgot-password.
#   1. Go to dash.cloudflare.com → Zero Trust → Turnstile → Create site.
#   2. Choose "Invisible" or "Managed" widget type; add localhost to allowed domains for dev.
#   3. Copy the Site Key (public) → NEXT_PUBLIC_TURNSTILE_SITE_KEY
#      Copy the Secret Key       → TURNSTILE_SECRET_KEY
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Issuer-hosted login widget (optional; required to render Turnstile on auth.lax.bid)
# TURNSTILE_SITE_KEY=
# CSP — Content-Security-Policy.
#   CSP_ENFORCE=0  → report-only (safe to start with; monitor violations before enforcing)
#   CSP_ENFORCE=1  → enforcing (blocks violating scripts/styles)
# CSP_ENFORCE=0
# NEXT_PUBLIC_CSP_REPORT_URI=  (optional — Sentry or report-uri.com endpoint for violation reports)
LOG_LEVEL=info
# When true (default), admin lot/sale APIs reject non-English auction_type values. Set to false to allow full catalogue locally.
ENGLISH_ONLY_AUCTIONS=true
# Legal entity stamped on staff-created sales (`sale.created_by_legal_entity_id`). After `db:seed:dev`, use the
# seeded LAX House Stock org id. Required for admin venues/sales when SSR cannot browse legal entities.
PLATFORM_CATALOG_LEGAL_ENTITY_ID=30000000-0000-4000-9000-000000000001
# Sentry (optional)
# SENTRY_DSN_API=
# SENTRY_DSN_WS=
# SENTRY_DSN_WEB=
# NEXT_PUBLIC_SENTRY_DSN_WEB=
# SENTRY_DSN_AUTH=
# Optional bearer token for apps/auth /metrics (required to expose metrics in production).
# METRICS_TOKEN=
# SENTRY_DSN_WORKER=
# SENTRY_DSN_ART=

# Stripe / Connect (apps/api — optional until Connect webhooks are exercised)
# STRIPE_SECRET_KEY — sk_test_… / sk_live_…
# STRIPE_PUBLISHABLE_KEY — pk_test_… / pk_live_… for client-side Stripe.js
# STRIPE_CONNECT_WEBHOOK_SECRET — whsec_…; Connect account updates (Connected accounts scope)
# STRIPE_TRANSFERS_WEBHOOK_SECRET — whsec_…; platform transfer events (Your account scope)
# STRIPE_PAYMENTS_WEBHOOK_SECRET — whsec_…; disputes, refunds, payment_intent.* (Your account scope)
# STRIPE_CARD_CHECKOUT_MAX — major GBP units; card Checkout up to this amount inclusive (default 10000)
# STRIPE_MANUAL_REVIEW_MIN — major GBP units; amounts at/above require finance release (default 500000)
# STRIPE_ABSOLUTE_MAX — major GBP units; hard cap for online checkout (default 999999.99)
# Do NOT OAuth the Connect platform account through Xero Payment services (breaks seller Connect).
# XERO_PAYMENT_BANK_ACCOUNT_CODE — chart account for recording Stripe captures against Xero invoices (default 090)
STRIPE_CARD_CHECKOUT_MAX=10000
STRIPE_MANUAL_REVIEW_MIN=500000
STRIPE_ABSOLUTE_MAX=999999.99
# Private sales (apps/api). All optional: a missing value keeps the step that needs it blocked.
# PRIVATE_SALE_COMMISSION_BPS — seller's commission on new deals in basis points (1500 = 15%)
# PRIVATE_SALE_BUYER_FEE_BPS — buyer's fee in basis points (default 0)
# PRIVATE_SALE_VAT_TREATMENTS — the accountant's list as code:Label pairs, e.g. margin_scheme:Margin scheme;agent_commission_only:Agent's commission only
# PRIVATE_SALE_PAYMENT_DUE_DAYS — days from invoice to payment due (default 7, the suggested value)
# PRIVATE_SALE_COLLECTION_DUE_DAYS — days from payment to collection due (default 14, the suggested value)
# PRIVATE_SALE_TERMS_VERSION — the approved private sale terms version
PRIVATE_SALE_COMMISSION_BPS=
PRIVATE_SALE_BUYER_FEE_BPS=
PRIVATE_SALE_VAT_TREATMENTS=
PRIVATE_SALE_PAYMENT_DUE_DAYS=
PRIVATE_SALE_COLLECTION_DUE_DAYS=
PRIVATE_SALE_TERMS_VERSION=
# Years a private sale's record, with its enquiry, is kept after the deal ends (default 5, minimum 5)
PRIVATE_SALE_RECORD_RETENTION_YEARS=5
# Years the name and ID type of a collection hand-over are kept after the person's account is erased (default 6, minimum 3)
COLLECTION_HANDOVER_RETENTION_YEARS=6
# Veriff KYC (apps/api — optional until identity verification is exercised)
# VERIFF_API_KEY — X-AUTH-CLIENT from Veriff Customer Portal
# VERIFF_SHARED_SECRET — HMAC shared secret for webhooks
# VERIFF_API_BASE_URL — default https://stationapi.veriff.com
# KYC_THRESHOLD_AMOUNT — major currency units at which buyer verification is required (API default 1000)
# KYC_THRESHOLD_CURRENCY — ISO 4217 code for threshold comparisons (API default GBP)
# STRICT_BID_ELIGIBILITY_ENABLED — hard email + approved-KYC bid gate (defaults true outside production)
# KYC_ONBOARDING_ENABLED — server-side proactive onboarding rollout; unset defaults on unless APP_ENV=production
# FULL_BUYER_ONBOARDING_ENABLED — independent one-time interests/recommendations rollout (same default)
# MARKETING_PROMPTS_ENABLED — contextual selling/signup prompts; defaults off in production
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
VERIFF_API_KEY=
VERIFF_SHARED_SECRET=
VERIFF_API_BASE_URL=https://stationapi.veriff.com
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_TRANSFERS_WEBHOOK_SECRET=
STRIPE_PAYMENTS_WEBHOOK_SECRET=
KYC_THRESHOLD_AMOUNT=1000
KYC_THRESHOLD_CURRENCY=GBP
STRICT_BID_ELIGIBILITY_ENABLED=true
KYC_ONBOARDING_ENABLED=false
FULL_BUYER_ONBOARDING_ENABLED=false
MARKETING_PROMPTS_ENABLED=true

# Twilio Verify — phone number OTP (optional; set ENABLE_PHONE_VERIFICATION=true in production)
# TWILIO_VERIFY_SERVICE_SID — Verify Service SID (VA…) from Twilio Console
# Prefer TWILIO_API_KEY_SID + TWILIO_API_KEY_SECRET in production; TWILIO_AUTH_TOKEN for local dev only
ENABLE_PHONE_VERIFICATION=false
TWILIO_ACCOUNT_SID=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=

# Object storage for presigned uploads (local disk or S3-compatible / DigitalOcean Spaces)
# STORAGE_DRIVER=local
# STORAGE_LOCAL_ROOT=./uploads
# STORAGE_DRIVER=s3
# S3_BUCKET=lax-media
# S3_REGION=lon1
# S3_ENDPOINT=https://lon1.digitaloceanspaces.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://lax-media.lon1.cdn.digitaloceanspaces.com
# STORAGE_READ_MODE=public
# SIGNED_GET_TTL_SEC=900
# Short TTL (seconds) for sensitive Source-of-Funds document downloads (staff, aml.review only). Default 120.
# SOF_DOWNLOAD_TTL_SEC=120

# Web Push (required in production for browser push alerts; generate: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
ENABLE_WHATSAPP_CHANNEL=false

# Email (Postmark transactional + Zoho Campaigns newsletter push)
EMAIL_PROVIDER=console
EMAIL_FROM="LAX <no-reply@mail.lax.bid>"
EMAIL_REPLY_TO=settlements@lax.bid
EMAIL_BASE_URL=http://localhost:3000
POSTMARK_SERVER_TOKEN=
POSTMARK_TRANSACTIONAL_STREAM=outbound
POSTMARK_BROADCAST_STREAM=broadcast
POSTMARK_WEBHOOK_BASIC_AUTH=
EMAIL_UNSUBSCRIBE_SECRET=replace-with-a-long-random-unsubscribe-secret

# Email alerts. ALERT_LINK_SECRET signs confirm and stop links (API and worker share it). During a
# rotation, keep the old key in ALERT_LINK_PREVIOUS_* so links already sent still work. shop-api reads
# the same four variables for LAX Shop and lax.art; give it its own ALERT_LINK_SECRET when deployed.
ALERT_LINK_SECRET=replace-with-a-long-random-alert-link-secret
ALERT_LINK_KEY_ID=k1
# off | dry_run | on. Run `pnpm --filter @auction/worker alerts:seed` before leaving off.
ALERTS_SEND_MODE=off
# Alert retention prune (worker for Bid, shop-api for Shop and lax.art). Off, it only logs what it
# would remove. Turn it on once the dry-run counts look right.
ALERT_RETENTION_PURGE_ENABLED=false
# Each product's From address as JSON; a product without an entry uses EMAIL_FROM.
# EMAIL_FROM_BY_PRODUCT={"bid":"alerts@mail.lax.bid"}
REQUIRE_EMAIL_VERIFICATION=false
ZOHO_CAMPAIGNS_API_KEY=
ZOHO_CAMPAIGNS_LIST_KEY=

# ATG (GAP API) White Label sync - see docs/integrations/atg.md.
# Off by default. The worker needs every ATG_* value below when ATG_SYNC_ENABLED=true (plus
# S3_PUBLIC_BASE_URL); the API reads ATG_SYNC_ENABLED and ATG_WHITE_LABEL_BASE_URL; the web
# app reads ATG_WHITE_LABEL_BASE_URL.
ATG_SYNC_ENABLED=false
ATG_API_BASE_URL=https://api.globalauctionplatform.com
ATG_API_USERNAME=
ATG_API_PASSWORD=
ATG_CLIENT_ID=
# Production White Label PlatformCode is SR (ATG corrected an earlier "londonart" value).
ATG_PLATFORM_CODE=
ATG_INCREMENT_SET_ID=
ATG_DEFAULT_CATEGORY=
# Auction type (Timed/Live) and distribution are chosen per sale in the admin ATG tab.
ATG_ARTIST_PLACEMENT=description
ATG_TIMEZONE=Europe/London
ATG_POLL_INTERVAL_MS=120000
ATG_WHITE_LABEL_BASE_URL=

# Xero (optional — all three required together on API; connect org via Admin → Xero)
# Redirect URI must match the web callback route exactly, e.g.:
# XERO_REDIRECT_URI=http://localhost:3000/admin/integrations/xero/callback
# NEXT_PUBLIC_SITE_URL must use the same origin as XERO_REDIRECT_URI (avoid browsing via 0.0.0.0).
# Webhook signing key from the Xero developer portal (optional until you enable webhooks):
# XERO_WEBHOOK_KEY=
# XERO_WEBHOOK_INBOX_MODE=legacy
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# Revenue account code and tax type are org-specific in Xero:
# XERO_DEFAULT_REVENUE_ACCOUNT_CODE=200
# XERO_DEFAULT_TAX_TYPE=NONE
# When true, a Xero invoice failure blocks buyer checkout (503). Default false: checkout proceeds
# and the invoice is created later by the retry-xero-invoice-creation cron (ledger eventually consistent).
# XERO_INVOICE_BLOCKING=false
# Legal-entity AR + ACCPAY bills (SE-P14a; optional — see plan "Deferred work" before enabling contact mode in prod)
# XERO_USE_LEGAL_ENTITY_CONTACT — when true, buyer AR Contacts use legal_entity.xero_contact_id (default false in API)
# XERO_PAYOUT_BILL_ACCOUNT_CODE — chart account code for supplier bills from paid payouts (API default 400)
XERO_USE_LEGAL_ENTITY_CONTACT=false
XERO_PAYOUT_BILL_ACCOUNT_CODE=400

# Internal cron / worker ↔ API (apps/api + apps/worker)
# CRON_INTERNAL_SECRET — shared secret for X-Cron-Secret on internal job routes; min 24 chars when set (optional until bulk jobs)
CRON_INTERNAL_SECRET=
# Background ownership (API + worker must match in the same deploy). Defaults keep lifecycle on API and finance cron on API rollback.
# LIFECYCLE_EXECUTION_OWNER=api
# LIFECYCLE_EXECUTION_OWNER=worker
# ABSENTEE_REPLAY_OWNER=api_rollback
# ABSENTEE_REPLAY_OWNER=worker
# FINANCE_CRON_EXECUTION_OWNER=api_rollback
# FINANCE_CRON_EXECUTION_OWNER=worker
# FINANCE_CRON_API_ROLLBACK=true
# DOMAIN_EVENT_PUBLISH_VALIDATE=off
# XERO_API_WRITES_DISABLED=false

# Web (apps/web)
# Set to "false" on test/staging so search engines do not index non-production hosts.
# NEXT_PUBLIC_ALLOW_INDEXING=false
# Dashboard v2 UI (overview shell, density, admin cockpit). Set to 0 or false to prefer legacy layouts where gated.
# NEXT_PUBLIC_DASHBOARD_V2=1
# Enumeration-safe email-first sign-in (email step → credentials step with magic-link option). On by default; set to "false" to revert to the single-screen email+password login.
# NEXT_PUBLIC_EMAIL_FIRST_LOGIN=false
# Browser → API (must be reachable from visitors' machines).
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_AUTH_URL=http://localhost:3003
NEXT_PUBLIC_WS_URL=http://localhost:3002
# Optional domain for non-auth preference/analytics cookies only. Auth sessions stay host-only.
# NEXT_PUBLIC_COOKIE_DOMAIN=.lax.bid
# Confidential Bid BFF OIDC client. Never expose these as NEXT_PUBLIC_*.
OIDC_CLIENT_SECRET_LAX_BID_WEB=
# 32 random bytes encoded as base64url or 64 hex characters.
BID_BFF_SESSION_ENCRYPTION_KEY=
# Public CDN base for media stored in object storage (S3 / DO Spaces). The web
# app prefixes bare object keys with this base so next/image accepts them.
# Must match S3_PUBLIC_BASE_URL on the API side.
# NEXT_PUBLIC_MEDIA_BASE_URL=https://media.example.com
# When not "false", admin + marketing surfaces treat catalogue as English-only (matches API ENGLISH_ONLY_AUCTIONS).
NEXT_PUBLIC_ENGLISH_ONLY_AUCTIONS=true
# Google Tag Manager — optional; analytics loads only in production builds when set. Leave blank for local/test.
# NEXT_PUBLIC_GTM_ID=GTM-W6K4N67Z
# GA4 stream used to select the matching `_ga_<stream>` session cookie for server-event stitching.
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-GDG4D2YELR
# Lean first/last UTM attribution. Keep both flags aligned and false until the
# additive migration, API, worker, web, and GTM/sGTM mappings are deployed.
MARKETING_ATTRIBUTION_ENABLED=false
NEXT_PUBLIC_MARKETING_ATTRIBUTION_ENABLED=false
# When "true", show deferred live-bidding shortcuts (e.g. command palette). Default off until saleroom ships.
# NEXT_PUBLIC_SHOW_LIVE_BIDDING_NAV=true
# When "true", render the "Sign in with Apple" button on /login, /register, and surface Apple linking in settings.
# Requires APPLE_CLIENT_ID / APPLE_CLIENT_SECRET on the API + a domain-association file served at /.well-known.
NEXT_PUBLIC_APPLE_ENABLED=false
# Server Components / SSR → API on the same machine (avoid public-IP hairpin). Omit to fall back to NEXT_PUBLIC_API_URL.
# Use the same hostname as NEXT_PUBLIC_API_URL when both are loopback (e.g. both `localhost`), so Better Auth sees a consistent Host with API_PUBLIC_URL.
INTERNAL_API_URL=http://127.0.0.1:3001

# Checkout / settlements copy (optional; sensible defaults shown in UI if unset)
# Quote values if you use `source .env` in bash (parentheses/spaces break unquoted assignments).
NEXT_PUBLIC_SETTLEMENTS_EMAIL=settlements@example.com
NEXT_PUBLIC_SETTLEMENTS_PHONE="+1 (000) 000-0000"

# WebSocket gateway (apps/ws)
WS_PORT=3002
CORS_ORIGIN=http://localhost:3000
OIDC_ISSUER=http://localhost:3003
JWKS_URL=http://localhost:3003/.well-known/jwks.json
WS_JWT_AUDIENCE=lax-ws

# Shop Identity app (apps/shop-identity)
SHOP_IDENTITY_PORT=3010
# 32-byte key (64 hex chars) for AES-256-GCM sealing of OIDC refresh tokens at rest
SHOP_IDENTITY_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Shop commerce API (apps/shop-api) — use shop_app role in real environments
SHOP_API_PORT=3011
SHOP_API_BASE_URL=http://localhost:3011
# Shop Admin asks the Bid API which staff tools the signed-in person can open (product switcher),
# with a token exchanged for that person. Unset, the switcher shows LAX Admin alone.
BID_API_INTERNAL_BASE_URL=http://127.0.0.1:3001
# Shared secret: Shop Identity presents this as Bearer when proxying guest basket calls to Shop API.
SHOP_API_BFF_TOKEN=local-shop-api-bff-token-at-least-32-chars
# Phase flags on shop-api (default off in code; enable per docs/runbooks/shop-v1-phase-gates.md)
# SHOP_PORTAL_OWNERSHIP_ENABLED=true
# SHOP_ADMIN_ENABLED=true
# SHOP_PAYOUTS_ENABLED=true
# SHOP_THIRD_PARTY_ENABLED=true
# SHOP_ORIGINALS_ENABLED=true
# SHOP_MERCHANDISE_ENABLED=true
# Framing on editions and in the basket. Leave off until orders price framing.
# SHOP_FRAMING_ENABLED=true
# London Art Exchange Ltd issues digital certificates on the artist's written authority (default off)
# SHOP_LAX_CERTIFICATES_ENABLED=true
# Copies of one edition per order, shown as "Limit N per order" (default 2; "none" = stock only)
# SHOP_EDITION_ORDER_LIMIT=2
# SHOP_ADMIN_FINANCE_MAX_AUTH_AGE_SECONDS=900
# SHOP_FAKE_CHECKOUT_ENABLED=false
# Production only: false lets shop-api start without Stripe (checkout and payouts disabled),
# provided SHOP_PAYOUTS_ENABLED, SHOP_CONNECT_TRANSFERS_ENABLED and SHOP_ORIGINALS_ENABLED are off.
# SHOP_REQUIRE_STRIPE=true
# Optional Stripe for hosted checkout (omit locally to use fake checkout redirect).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# LAX Art payee Connect (D38): publishable key for embedded onboarding, Connect endpoint secret,
# owning Stripe platform (bid_sandbox | lax_art; lax_art required in production), automatic transfers.
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SHOP_CONNECT_WEBHOOK_SECRET=
# STRIPE_SHOP_CONNECT_PLATFORM_KEY=bid_sandbox
# SHOP_CONNECT_TRANSFERS_ENABLED=false
# Shop-api background tasks (stale checkout reaper, notify-me dispatch). Set SHOP_SCHEDULER_ENABLED=false in tests.
# SHOP_SCHEDULER_ENABLED=true
# SHOP_SCHEDULER_INTERVAL_MS=60000
# Staff inbox for LAX Bid contact form enquiries (api). Unset: no alert email; enquiries still
# appear in the staff work inbox. See docs/runbooks/contact-enquiries.md.
# BID_ENQUIRY_NOTIFICATION_EMAIL=client-services@lax.bid
# Ops inbox for artwork enquiry alerts (Shop and LAX Art, branded per storefront) and
# lax.art general enquiries (contact, private viewing, advisory, selling).
# SHOP_ENQUIRY_NOTIFICATION_EMAIL=shop-ops@lax.bid
# SHOP_OPS_ALERT_EMAIL=shop-ops@lax.bid
# Public OpenAPI server URL (shop-api)
# SHOP_API_PUBLIC_BASE_URL=http://localhost:3011
# Internal URL used by the Shop storefront BFF to reach Shop Identity.
SHOP_IDENTITY_BASE_URL=http://localhost:3010
# App Platform private URL for server-side Shop Identity fetches (optional locally).
# SHOP_IDENTITY_INTERNAL_BASE_URL=http://localhost:3010
# Comma-separated HTTPS hostnames allowed by next/image for catalogue media.
# SHOP_IMAGE_REMOTE_HOSTS=images.example.com,cdn.example.com
# Public CDN base for shop-api media keys (presign/confirm); reuse S3_* from Bid when sharing a bucket.
# SHOP_MEDIA_PUBLIC_BASE_URL=https://cdn.example.com
# Editorial CMS (lax.art hubs, exhibitions, stories, visit pages)
# SHOP_EDITORIAL_ENABLED=true
# SHOP_EDITORIAL_PREVIEW_SECRET=local-editorial-preview-secret-32-chars-min
# ART_EDITORIAL_ENABLED=true
# Staff publishes reach lax.art immediately: shop-api POSTs to Art's /api/revalidate with this shared
# secret (>= 32 chars, identical on both services). Set both shop-api vars together, or neither.
# ART_REVALIDATE_SECRET=local-art-revalidate-secret-32-chars-min
# ART_REVALIDATE_URL=http://localhost:3050/api/revalidate
# GitHub test env (optional): vars.SHOP_EDITORIAL_ENABLED, vars.ART_EDITORIAL_ENABLED, vars.SHOP_MEDIA_PUBLIC_BASE_URL
# Art SEO (see docs/runbooks/thelax-seo-migration.md). Indexing is on only for www.thelax.art;
# ART_ALLOW_INDEXING overrides the host check (set "false" on staging, never "true" off-prod).
# ART_ALLOW_INDEXING=false
# GA4 loads only after cookie consent; leave unset locally.
# ART_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Google Search Console HTML-tag verification token (content value only).
# ART_GOOGLE_SITE_VERIFICATION=
OIDC_CLIENT_ID=lax-shop-web
# Must match the secret hashed by `pnpm --filter @auction/db db:configure-oidc-clients`.
# docker-compose default for local Shop Identity:
OIDC_CLIENT_SECRET=local-shop-identity-client-secret-32
OIDC_CLIENT_SECRET_LAX_SHOP_WEB=local-shop-identity-client-secret-32
OIDC_CLIENT_SECRET_LAX_ART_WEB=local-lax-art-web-client-secret-32
OIDC_CLIENT_SECRET_LAX_ACCOUNT_WEB=local-lax-account-web-client-secret-32
LAX_ACCOUNT_PUBLIC_ORIGIN=http://localhost:3040
LAX_ACCOUNT_SESSION_ENCRYPTION_KEY=local-lax-account-session-encryption-key-32
# Server-to-server API URLs LAX Account reads the portfolio from. Bid falls back to INTERNAL_API_URL,
# then NEXT_PUBLIC_API_URL; Shop falls back to SHOP_API_BASE_URL.
# LAX_BID_API_URL=http://localhost:3001
# LAX_SHOP_API_URL=http://localhost:3011
# Origins LAX Account may load product images from (comma-separated). Defaults to the media bases
# above (NEXT_PUBLIC_MEDIA_BASE_URL, SHOP_MEDIA_PUBLIC_BASE_URL); read at build time for the CSP.
# LAX_MEDIA_ORIGINS=https://lax-media.lon1.cdn.digitaloceanspaces.com
# Ops-only input consumed by db:configure-oidc-clients.
# OIDC_CLIENT_SECRET_LAX_BID_WEB=
# Ops-only acknowledgement for a reviewed full-registry retirement run.
# OIDC_DISABLE_UNREGISTERED=false
OIDC_REDIRECT_URI=http://localhost:3010/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3020/signed-out
# Storefront origin for Shop Identity user-facing redirects (login success, errors, logout landing)
SHOP_STOREFRONT_URL=http://localhost:3020
# lax.art public URL for shop-api channel-aware catalogue and notification links
LAX_ART_PUBLIC_URL=http://localhost:3050
# Registered company name that owns Shop and lax.art records in the cross-product portfolio.
# Defaults to the operator in @auction/branding; set it only if the company changes.
# LAX_ART_LEGAL_NAME=London Art Exchange Ltd
# Public Identity host for Shop registration (canonical auth issuer)
IDENTITY_PUBLIC_BASE_URL=http://localhost:3003
SESSION_SECRET=local-shop-session-secret-at-least-32-chars
# Optional Shop OIDC round-trip (`pnpm shop:auth:test`); seeded staff works locally.
# SHOP_OIDC_TEST_EMAIL=admin@lax.bid
# SHOP_OIDC_TEST_PASSWORD=Password123!

# Shop storefront (apps/shop) — mirror shop-api phase flags when testing portal / merchandise routes
# SHOP_PORTAL_OWNERSHIP_ENABLED=true
# SHOP_MERCHANDISE_ENABLED=true
# Framing on editions and in the basket. Leave off until orders price framing.
# SHOP_FRAMING_ENABLED=true

# Worker (apps/worker)
WORKER_PORT=3004
# Use worker_app in production (see packages/db/src/migrate-roles.ts). Local dev may fall back to DATABASE_URL.
# DATABASE_URL_WORKER=postgresql://worker_app:worker-password@localhost:5432/auction
# API_INTERNAL_BASE_URL above is also used for worker cron rollback.
# Optional ClamAV daemon for Source-of-Funds document malware scanning. When unset,
# SoF uploads are NOT scanned (no-op) — acceptable for local dev only.
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# Payout statement PDFs — footer contact email (optional; worker falls back to EMAIL_REPLY_TO then EMAIL_FROM)
PAYOUT_STATEMENT_CONTACT_EMAIL=support@lax.bid
ZOHO_API_HOST=https://www.zohoapis.eu
ZOHO_CRM_API_HOST=https://www.zohoapis.eu
ZOHO_ACCOUNTS_HOST=https://accounts.zoho.eu
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_CRM_SYNC_MODE=off
# ZOHO_CRM_ENABLED_EVENT_TYPES=user.registered
# ZOHO_CRM_UPSERT_TRIGGER=[]
# ZOHO_CRM_EXPECTED_ORG_TYPE=sandbox
# ZOHO_CRM_LEAD_STATUS_NEW=New (Unassigned)
# ZOHO_CRM_AUCTION_PIPELINE=
# ZOHO_CRM_DEAL_STAGE_LOT_WON=
# ZOHO_CRM_DEAL_STAGE_PAYMENT_CAPTURED=
# ZOHO_CRM_DEAL_STAGE_PAYMENT_REFUNDED=
# ZOHO_CRM_DEAL_STAGE_SHOP_PAID=
# SHOP_ZOHO_CATALOGUE_SYNC_ENABLED=false
# ZOHO_CRM_CURSOR_BATCH_SIZE=100
# ZOHO_CRM_TICK_TIME_BUDGET_MS=2000
# Artworks coming in from Zoho Products: off | dry_run | live (worker). Needs the three OAuth
# values above and WEBHOOK_EVENTS_PROCESS=true. Leave off or dry_run until the import report is reviewed.
# ZOHO_ARTWORK_SYNC_MODE=off
# LAX artwork state (Status, stock code) going out to Zoho Products: off | dry_run | live (worker).
# live needs the OAuth values above with the ZohoCRM.modules.products.UPDATE scope; dry_run only logs.
# ZOHO_ARTWORK_WRITEBACK_MODE=off
# The LAX listing on Zoho Products (where each original is, with a link): off | dry_run | live
# (worker). Anything but off needs the OAuth values above, LAX Shop's API and the inventory
# machine pair (the same pair LAX Shop holds), and the lax.art and LAX Admin public addresses.
# ZOHO_ARTWORK_LISTING_MODE=off
# Print groups mirrored from LAX to Zoho CRM (Print_Products, Edition_Ledgers), and the LAX-PRT code
# added to the register: off | dry_run | live (worker). Anything but off needs the OAuth values above;
# live also needs ZOHO_CRM_EXPECTED_ORG_TYPE. Sandbox only until the release.
# ZOHO_FULFILMENT_MIRROR_MODE=off
# Zoho Campaigns unsubscribes and hard bounces recorded in LAX's suppression list: off | dry_run |
# live (worker). Read-only towards Zoho. Needs the OAuth values above (with the Campaigns contact
# read scope) and ZOHO_CAMPAIGNS_LIST_KEY. dry_run only logs what it would record.
# ZOHO_CAMPAIGNS_SUPPRESSION_SYNC_MODE=off
# SHOP_API_INVENTORY_BASE_URL=
# INVENTORY_MACHINE_CLIENT_ID=
# INVENTORY_MACHINE_CLIENT_SECRET=
# LAX_ART_PUBLIC_URL=
# LAX_ADMIN_PUBLIC_URL=
# Shared secret (32+ characters) the Zoho workflow sends in X-LAX-Webhook-Secret (api).
# ZOHO_ARTWORK_WEBHOOK_SECRET=

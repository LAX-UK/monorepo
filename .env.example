# Root / shared — copy to .env and adjust (apps read their own vars via process.env)

# Database (PostgreSQL)
# Compose publishes Postgres to the host. If `pnpm db:migrate` fails with password errors but
# `docker compose exec postgres psql -U postgres -d auction` works, another server is bound to
# your host port — set POSTGRES_PUBLISH_PORT=5433 below and match DATABASE_URL's port.
# POSTGRES_PUBLISH_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auction
# Production role split (optional locally; required in DO App Platform after P1.1)
# DATABASE_URL_OWNER=postgresql://auction_owner:owner-password@host:5432/auction
# DATABASE_URL_AUTH=postgresql://auth_app:auth-password@host:5432/auction
# DATABASE_URL_API=postgresql://api_app:api-password@host:5432/auction
# DATABASE_URL_WORKER=postgresql://worker_app:worker-password@host:5432/auction
# AUTH_APP_DB_PASSWORD=
# API_APP_DB_PASSWORD=
# WORKER_APP_DB_PASSWORD=

# Redis (cache, pub/sub for real-time)
REDIS_URL=redis://127.0.0.1:6379

# API (apps/api)
PORT=3001
API_PUBLIC_URL=http://localhost:3001
OIDC_ISSUER_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-16-chars
# Production cookie sharing for lax.bid sibling subdomains; leave blank locally.
# COOKIE_DOMAIN=.lax.bid
# CORS_ALLOWED_ORIGINS=https://lax.bid,https://api.lax.bid,https://auth.lax.bid,https://ws.lax.bid

# Social login (optional locally). See docs/security/social-login-setup.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple uses the Services ID as APPLE_CLIENT_ID. Generate APPLE_CLIENT_SECRET with:
# APPLE_TEAM_ID=... APPLE_KEY_ID=... APPLE_CLIENT_ID=... APPLE_PRIVATE_KEY='...' pnpm gen:apple-secret
# Rotate APPLE_CLIENT_SECRET at least every 180 days.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Paste Apple's domain association file content here for apps/auth to serve at:
# /.well-known/apple-developer-domain-association.txt
APPLE_DOMAIN_ASSOCIATION=
# SHOPIFY_WEBHOOK_SECRET=
# WORDPRESS_WEBHOOK_SECRET=

# API hardening
# VERIFY_ORIGIN=true requires Origin/Referer to match WEB_ORIGIN for mutating requests (excludes /api/auth)
VERIFY_ORIGIN=false
LOG_LEVEL=info
# When true (default), admin lot/sale APIs reject non-English auction_type values. Set to false to allow full catalogue locally.
ENGLISH_ONLY_AUCTIONS=true
# Sentry (optional)
# SENTRY_DSN_API=
# SENTRY_DSN_WS=
# SENTRY_DSN_WEB=
# NEXT_PUBLIC_SENTRY_DSN_WEB=
# SENTRY_DSN_AUTH=
# SENTRY_DSN_WORKER=

# Stripe / KYC (apps/api — optional until checkout, Identity, or Connect webhooks are exercised)
# STRIPE_SECRET_KEY — sk_test_… / sk_live_…
# STRIPE_PUBLISHABLE_KEY — pk_test_… / pk_live_… for client-side Stripe.js
# STRIPE_IDENTITY_WEBHOOK_SECRET — whsec_…; verifies Identity webhook signatures (SE-P3)
# STRIPE_CONNECT_WEBHOOK_SECRET — whsec_…; verifies Connect webhook signatures (SE-P6)
# KYC_THRESHOLD_AMOUNT — major currency units at which buyer Identity verification is required (API default 1000)
# KYC_THRESHOLD_CURRENCY — ISO 4217 code for threshold comparisons (API default GBP)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_IDENTITY_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
KYC_THRESHOLD_AMOUNT=1000
KYC_THRESHOLD_CURRENCY=GBP

# Object storage for presigned uploads (local disk or S3-compatible / DigitalOcean Spaces)
# STORAGE_DRIVER=local
# STORAGE_LOCAL_ROOT=./uploads
# STORAGE_DRIVER=s3
# S3_BUCKET=lax-media
# S3_REGION=lon1
# S3_ENDPOINT=https://lon1.digitaloceanspaces.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://lax-media.lon1.cdn.digitaloceanspaces.com
# STORAGE_READ_MODE=public
# SIGNED_GET_TTL_SEC=900

# Web Push (optional — enable browser push; generate keys: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
ENABLE_WHATSAPP_CHANNEL=false

# Email (Postmark transactional + Zoho Campaigns newsletter push)
EMAIL_PROVIDER=console
EMAIL_FROM="LAX <no-reply@mail.lax.bid>"
EMAIL_REPLY_TO=settlements@lax.bid
EMAIL_BASE_URL=http://localhost:3000
POSTMARK_SERVER_TOKEN=
POSTMARK_TRANSACTIONAL_STREAM=outbound
POSTMARK_BROADCAST_STREAM=broadcast
POSTMARK_WEBHOOK_BASIC_AUTH=
EMAIL_UNSUBSCRIBE_SECRET=replace-with-a-long-random-unsubscribe-secret
REQUIRE_EMAIL_VERIFICATION=false
ZOHO_CAMPAIGNS_API_KEY=
ZOHO_CAMPAIGNS_LIST_KEY=

# Xero (optional — all three required together on API; connect org via Admin → Xero)
# Redirect URI must match the web callback route exactly, e.g.:
# XERO_REDIRECT_URI=http://localhost:3000/admin/integrations/xero/callback
# Webhook signing key from the Xero developer portal (optional until you enable webhooks):
# XERO_WEBHOOK_KEY=
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# Revenue account code and tax type are org-specific in Xero:
# XERO_DEFAULT_REVENUE_ACCOUNT_CODE=200
# XERO_DEFAULT_TAX_TYPE=NONE
# XERO_INVOICE_DUE_DAYS=14
# Legal-entity AR + ACCPAY bills (SE-P14a; optional — see plan "Deferred work" before enabling contact mode in prod)
# XERO_USE_LEGAL_ENTITY_CONTACT — when true, buyer AR Contacts use legal_entity.xero_contact_id (default false in API)
# XERO_PAYOUT_BILL_ACCOUNT_CODE — chart account code for supplier bills from paid payouts (API default 400)
XERO_USE_LEGAL_ENTITY_CONTACT=false
XERO_PAYOUT_BILL_ACCOUNT_CODE=400

# Internal cron / worker ↔ API (apps/api + apps/worker)
# CRON_INTERNAL_SECRET — shared secret for X-Cron-Secret on internal job routes; min 24 chars when set (optional until bulk jobs)
CRON_INTERNAL_SECRET=

# Web (apps/web)
# Dashboard v2 UI (overview shell, density, admin cockpit). Set to 0 or false to prefer legacy layouts where gated.
# NEXT_PUBLIC_DASHBOARD_V2=1
# Browser → API (must be reachable from visitors' machines).
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3002
# When not "false", admin + marketing surfaces treat catalogue as English-only (matches API ENGLISH_ONLY_AUCTIONS).
NEXT_PUBLIC_ENGLISH_ONLY_AUCTIONS=true
# When "true", show deferred live-bidding shortcuts (e.g. command palette). Default off until saleroom ships.
# NEXT_PUBLIC_SHOW_LIVE_BIDDING_NAV=true
# Server Components / SSR → API on the same machine (avoid public-IP hairpin). Omit to fall back to NEXT_PUBLIC_API_URL.
INTERNAL_API_URL=http://127.0.0.1:3001

# Checkout / settlements copy (optional; sensible defaults shown in UI if unset)
# Quote values if you use `source .env` in bash (parentheses/spaces break unquoted assignments).
NEXT_PUBLIC_SETTLEMENTS_EMAIL=settlements@example.com
NEXT_PUBLIC_SETTLEMENTS_PHONE="+1 (000) 000-0000"

# WebSocket gateway (apps/ws)
WS_PORT=3002
CORS_ORIGIN=http://localhost:3000
OIDC_ISSUER=http://localhost:3001
JWKS_URL=http://localhost:3001/.well-known/jwks.json
LEGACY_WS_COOKIE_RELAY=false

# Worker (apps/worker)
WORKER_PORT=3004
# Payout statement PDFs — footer contact email (optional; worker falls back to EMAIL_REPLY_TO then EMAIL_FROM)
PAYOUT_STATEMENT_CONTACT_EMAIL=support@lax.bid
ZOHO_API_HOST=https://www.zohoapis.eu
ZOHO_ACCOUNTS_HOST=https://accounts.zoho.eu
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=

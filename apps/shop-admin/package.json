{
  "name": "@auction/shop-admin",
  "version": "0.0.0",
  "private": true,
  "description": "LAX Shop staff admin BFF",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3030 --turbopack",
    "build": "next build",
    "start": "next start --port 3030",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node ../../scripts/ci/require-node-version.mjs && playwright test",
    "test:e2e:local-setup": "playwright test --config playwright.local.config.ts",
    "test:e2e:a11y": "node ../../scripts/ci/require-node-version.mjs && PLAYWRIGHT_E2E=1 playwright test e2e/axe.spec.ts e2e/staff-roles.spec.ts",
    "test:e2e:visual": "node ../../scripts/ci/require-node-version.mjs && PLAYWRIGHT_E2E=1 PLAYWRIGHT_VISUAL=1 playwright test e2e/pages-visual.spec.ts",
    "test:e2e:visual-update": "node ../../scripts/ci/require-node-version.mjs && PLAYWRIGHT_E2E=1 PLAYWRIGHT_VISUAL=1 playwright test e2e/pages-visual.spec.ts --update-snapshots --workers=1"
  },
  "dependencies": {
    "@auction/branding": "workspace:*",
    "@auction/identity-contracts": "workspace:*",
    "@auction/identity-rp": "workspace:*",
    "@auction/shop-contracts": "workspace:*",
    "@auction/shop-domain": "workspace:*",
    "@auction/staff-ui": "workspace:*",
    "@auction/ui": "workspace:*",
    "@sinclair/typebox": "^0.34.41",
    "@tanstack/react-table": "^8.21.3",
    "ioredis": "^5.6.1",
    "next": "15.5.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.56.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@auction/config-ts": "workspace:*",
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "jsdom": "^25.0.1",
    "otpauth": "^9.4.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

{
  "name": "@auction/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./exports": {
      "types": "./dist/exports/index.d.ts",
      "default": "./dist/exports/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "biome check . && node scripts/check-org-routes-dip.mjs && node scripts/check-error-status.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:admin-dip": "node scripts/check-admin-routes-dip.mjs",
    "check:org-dip": "node scripts/check-org-routes-dip.mjs"
  },
  "dependencies": {
    "@auction/auth": "workspace:*",
    "@auction/connect": "workspace:*",
    "@auction/db": "workspace:*",
    "@auction/domain": "workspace:*",
    "@auction/email": "workspace:^",
    "@auction/exports": "workspace:*",
    "@auction/http-headers": "workspace:*",
    "@auction/marketing-events": "workspace:*",
    "@auction/observability": "workspace:*",
    "@auction/queues": "workspace:*",
    "@auction/sms": "workspace:^",
    "@auction/types": "workspace:*",
    "@auction/validators": "workspace:*",
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "@better-auth/utils": "^0.4.0",
    "@bull-board/api": "^6.20.6",
    "@bull-board/hono": "^6.20.6",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.2",
    "@sentry/node": "^10.51.0",
    "better-auth": "^1.6.9",
    "bullmq": "^5.74.1",
    "drizzle-orm": "^0.41.0",
    "fflate": "^0.8.3",
    "hono": "^4.6.14",
    "hono-pino": "^0.10.3",
    "ioredis": "^5.4.2",
    "jose": "^6.2.3",
    "neverthrow": "^8.1.1",
    "pino": "^10.3.1",
    "postmark": "^4.0.7",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "safe-stable-stringify": "^2.5.0",
    "stripe": "^22.1.1",
    "web-push": "^3.6.7",
    "xero-node": "^9.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@auction/config-ts": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

{
  "name": "@auction/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@auction/auth": "workspace:*",
    "@auction/db": "workspace:*",
    "@auction/types": "workspace:*",
    "@auction/validators": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.2",
    "better-auth": "^1.1.14",
    "bullmq": "^5.74.1",
    "drizzle-orm": "^0.41.0",
    "hono": "^4.6.14",
    "ioredis": "^5.4.2",
    "neverthrow": "^8.1.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@auction/config-ts": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

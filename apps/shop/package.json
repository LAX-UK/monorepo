{
  "name": "@auction/shop",
  "version": "0.0.0",
  "private": true,
  "description": "LAX Shop storefront for staging OIDC flows",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3020 --turbopack",
    "build": "next build",
    "start": "next start --port 3020",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node ../../scripts/ci/require-node-version.mjs && playwright test",
    "test:e2e:a11y": "node ../../scripts/ci/require-node-version.mjs && PLAYWRIGHT_E2E=1 playwright test --grep @a11y",
    "test:e2e:visual": "node ../../scripts/ci/require-node-version.mjs && PLAYWRIGHT_E2E=1 PLAYWRIGHT_VISUAL=1 playwright test --grep @visual",
    "test:e2e:visual-update": "node ../../scripts/ci/require-node-version.mjs && PLAYWRIGHT_E2E=1 PLAYWRIGHT_VISUAL=1 playwright test --update-snapshots"
  },
  "dependencies": {
    "@auction/branding": "workspace:*",
    "@auction/lax-ecosystem": "workspace:*",
    "@auction/marketing-ui": "workspace:*",
    "@auction/shop-contracts": "workspace:*",
    "@auction/ui": "workspace:*",
    "zod": "^3.24.1",
    "next": "15.5.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@auction/config-ts": "workspace:*",
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@tailwindcss/postcss": "^4.1.13",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

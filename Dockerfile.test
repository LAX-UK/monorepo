# syntax=docker/dockerfile:1
# Full monorepo image for running Vitest (integration tests need Postgres via compose).
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    python3 \
    make \
    g++ \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app

COPY . .

RUN pnpm install --frozen-lockfile

ENV CI=true
ENV NODE_ENV=test

# Default: migrate then all package tests (override in compose if needed).
CMD ["sh", "-c", "pnpm --filter @auction/db db:migrate && pnpm turbo run test"]

# Build-time NEXT_PUBLIC_* values for the prod web Docker image (built in CI and
# pushed to DOCR). Single source of truth for non-secret, public values; these
# MUST mirror the prod Terraform locals in infra/terraform/ephemeral/prod/main.tf.
# Secrets (Turnstile site key, Sentry client DSN) and GitHub-managed vars (GTM id,
# consent banner) are injected by scripts/ci/web-build-args.sh via
# .github/workflows/build-images.yml. See infra/web-build/README.md.
#
# KEY=VALUE only, one per line. No quotes, no interpolation.
NEXT_PUBLIC_API_URL=https://api.lax.bid
NEXT_PUBLIC_AUTH_URL=https://auth.lax.bid
NEXT_PUBLIC_WS_URL=wss://ws.lax.bid
NEXT_PUBLIC_MEDIA_BASE_URL=https://lax-media.lon1.cdn.digitaloceanspaces.com
NEXT_PUBLIC_WEB_ORIGIN=https://lax.bid
NEXT_PUBLIC_ENGLISH_ONLY_AUCTIONS=true

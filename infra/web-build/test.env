# Build-time NEXT_PUBLIC_* values for the test web Docker image (built in CI and
# pushed to DOCR). Single source of truth for non-secret, public values; these
# MUST mirror the test Terraform locals in infra/terraform/ephemeral/test/main.tf.
# Secrets (Turnstile site key, Sentry token) and GitHub-managed vars (GTM id,
# consent banner) are injected separately by .github/workflows/build-images.yml.
#
# KEY=VALUE only, one per line. No quotes, no interpolation.
# NEXT_PUBLIC_ALLOW_INDEXING=false keeps the test site out of search indexes.
NEXT_PUBLIC_API_URL=https://test-api.lax.bid
NEXT_PUBLIC_AUTH_URL=https://test-auth.lax.bid
NEXT_PUBLIC_WS_URL=wss://test-ws.lax.bid
NEXT_PUBLIC_MEDIA_BASE_URL=https://lax-media.lon1.cdn.digitaloceanspaces.com
NEXT_PUBLIC_WEB_ORIGIN=https://test.lax.bid
NEXT_PUBLIC_ENGLISH_ONLY_AUCTIONS=true
NEXT_PUBLIC_ALLOW_INDEXING=false

# Copy to `.env` on the server. Docker Compose loads `.env` from this directory.
#
# Migrations: the API container runs `packages/db/dist/migrate.js` on every start
# (see apps/api/docker-entrypoint.sh), so fresh deploys and restarts apply pending migrations.
#
# Demo data (optional, after first deploy): loads categories, auctions, bids, auth users, etc.
#   docker compose -f docker-compose.prod.yml exec -T api node packages/db/dist/seed.js
# All seeded accounts use password: Password123!  (see packages/db/src/seed.ts)

# --- Postgres (container) ---
POSTGRES_USER=auction
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=auction

# --- Public URLs (use the same origin: droplet IP or domain, including scheme) ---
# Nginx serves web + API + WebSocket on one host/port. These three must match that origin.
WEB_ORIGIN=http://159.223.151.179
API_PUBLIC_URL=http://159.223.151.179
WS_PUBLIC_URL=http://159.223.151.179

BETTER_AUTH_SECRET=CHANGE_ME_AT_LEAST_16_CHAR_RANDOM_SECRET

VERIFY_ORIGIN=false
LOG_LEVEL=info

# Optional: bind Nginx to another host port (default 80)
# HTTP_PUBLISH_PORT=8080

# Optional: baked into the web image at build time (quote phone if uncommenting — safe for `source .env`)
# NEXT_PUBLIC_SETTLEMENTS_EMAIL=settlements@example.com
# NEXT_PUBLIC_SETTLEMENTS_PHONE="+1 (000) 000-0000"

# Copy to `.env` on the server. Docker Compose loads `.env` from this directory.
#
# Migrations: the API container does NOT run migrations on start (see
# apps/api/docker-entrypoint.sh). Migrations run from the dedicated migration job
# using `pnpm db:migrate:prod` with the privileged DATABASE_URL_OWNER URI.
# See docs/integrations/digitalocean.md and docs/architecture/06-deployment.md
# for the topology.
#
# Demo data (optional, after first deploy): loads categories, auctions, bids, auth users, etc.
#   docker compose -f docker-compose.prod.yml exec -T api node packages/db/dist/seed.js
# All seeded accounts use password: Password123!  (see packages/db/src/seed.ts)

# --- Postgres (container) ---
POSTGRES_USER=auction
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=auction

# --- Public URLs (use the same origin: droplet IP or domain, including scheme) ---
# Nginx serves web + API + WebSocket on one host/port. These three must match that origin.
WEB_ORIGIN=https://lax.bid
API_PUBLIC_URL=https://api.lax.bid
WS_PUBLIC_URL=wss://ws.lax.bid
OIDC_ISSUER_URL=https://auth.lax.bid
NEXT_PUBLIC_AUTH_URL=https://auth.lax.bid
OIDC_ISSUER=https://auth.lax.bid
JWKS_URL=https://auth.lax.bid/.well-known/jwks.json
LEGACY_WS_COOKIE_RELAY=false
# Session cookies shared across lax.bid, api.lax.bid, auth.lax.bid, and ws.lax.bid.
COOKIE_DOMAIN=.lax.bid

BETTER_AUTH_SECRET=CHANGE_ME_AT_LEAST_16_CHAR_RANDOM_SECRET

VERIFY_ORIGIN=false
CORS_ALLOWED_ORIGINS=https://lax.bid,https://api.lax.bid,https://auth.lax.bid,https://ws.lax.bid
LOG_LEVEL=info

# --- Production DB roles (P1.1) ---
# DATABASE_URL_OWNER is only for the DO migration Job (`pnpm db:migrate:prod`).
# Runtime components must use their least-privilege role URLs.
# DATABASE_URL_OWNER=postgresql://auction_owner:CHANGE_ME@HOST:25060/auction?sslmode=require
# DATABASE_URL_AUTH=postgresql://auth_app:CHANGE_ME@HOST:25060/auction?sslmode=require
# DATABASE_URL_API=postgresql://api_app:CHANGE_ME@HOST:25060/auction?sslmode=require
# DATABASE_URL_WORKER=postgresql://worker_app:CHANGE_ME@HOST:25060/auction?sslmode=require
# AUTH_APP_DB_PASSWORD=CHANGE_ME_AUTH_ROLE_PASSWORD
# API_APP_DB_PASSWORD=CHANGE_ME_API_ROLE_PASSWORD
# WORKER_APP_DB_PASSWORD=CHANGE_ME_WORKER_ROLE_PASSWORD

# Optional Sentry projects per app
# SENTRY_DSN_API=
# SENTRY_DSN_WS=
# SENTRY_DSN_WEB=
# NEXT_PUBLIC_SENTRY_DSN_WEB=
# SENTRY_DSN_AUTH=
# SENTRY_DSN_WORKER=

# Social login. See docs/security/social-login-setup.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple uses the Services ID as APPLE_CLIENT_ID. Generate APPLE_CLIENT_SECRET with:
# APPLE_TEAM_ID=... APPLE_KEY_ID=... APPLE_CLIENT_ID=... APPLE_PRIVATE_KEY='...' pnpm gen:apple-secret
# Rotate APPLE_CLIENT_SECRET at least every 180 days.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Paste Apple's domain association file content here for apps/auth to serve at:
# /.well-known/apple-developer-domain-association.txt
APPLE_DOMAIN_ASSOCIATION=
# SHOPIFY_WEBHOOK_SECRET=
# WORDPRESS_WEBHOOK_SECRET=

# Zoho EU (worker)
ZOHO_API_HOST=https://www.zohoapis.eu
ZOHO_ACCOUNTS_HOST=https://accounts.zoho.eu
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=

# Optional Web Push (API). Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@yourdomain.com

# --- DigitalOcean Spaces uploads ---
STORAGE_DRIVER=s3
S3_BUCKET=lax-media
S3_REGION=lon1
S3_ENDPOINT=https://lon1.digitaloceanspaces.com
S3_ACCESS_KEY_ID=CHANGE_ME_SPACES_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_SPACES_SECRET_KEY
S3_PUBLIC_BASE_URL=https://lax-media.lon1.cdn.digitaloceanspaces.com

# Allow auth cookies over plain HTTP (no HTTPS). Only enable for testing!
# For production, use HTTPS and leave this false.
ALLOW_HTTP_COOKIES=true

# Optional: bind Nginx to another host port (default 80)
# HTTP_PUBLISH_PORT=8080

# Optional: baked into the web image at build time (quote phone if uncommenting — safe for `source .env`)
# NEXT_PUBLIC_SETTLEMENTS_EMAIL=settlements@example.com
# NEXT_PUBLIC_SETTLEMENTS_PHONE="+1 (000) 000-0000"

# --- Xero (optional — consumed by `api`; do not put secrets in `web` / NEXT_PUBLIC_*) ---
# All three OAuth vars must be set together. Redirect URI must match Xero app + nginx path to API.
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_REDIRECT_URI=https://YOUR_HOST/admin/integrations/xero/callback
# XERO_WEBHOOK_KEY=
# XERO_DEFAULT_REVENUE_ACCOUNT_CODE=200
# XERO_DEFAULT_TAX_TYPE=NONE
# XERO_INVOICE_DUE_DAYS=14
# After OAuth, send the browser back to the web admin Xero page:
# XERO_POST_CONNECT_WEB_REDIRECT=https://YOUR_HOST/admin/integrations/xero

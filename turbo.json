    "STRIPE_PUBLISHABLE_KEY",
    "VERIFF_API_KEY",
    "VERIFF_SHARED_SECRET",
    "VERIFF_API_BASE_URL",
    "STRIPE_CONNECT_WEBHOOK_SECRET",
    "STRIPE_TRANSFERS_WEBHOOK_SECRET",
    "STRIPE_PAYMENTS_WEBHOOK_SECRET",
    "KYC_THRESHOLD_AMOUNT",
    "KYC_THRESHOLD_CURRENCY",
    "CRON_INTERNAL_SECRET",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_AUTH_URL",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_WS_URL",
    "NEXT_PUBLIC_COOKIE_DOMAIN",
    "NEXT_PUBLIC_REQUIRE_EMAIL_VERIFICATION",
    "NEXT_PUBLIC_ENABLE_ARTISTS",
    "NEXT_PUBLIC_USE_MOCK_ARTISTS",
    "NEXT_PUBLIC_DASHBOARD_V2",
    "NEXT_PUBLIC_ENGLISH_ONLY_AUCTIONS",
    "ENGLISH_ONLY_AUCTIONS",
    "NEXT_PUBLIC_MEDIA_BASE_URL",
    "NEXT_PUBLIC_APPLE_ENABLED",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
    "NEXT_PUBLIC_GTM_ID",
    "NEXT_PUBLIC_CSP_REPORT_URI",
    "CSP_ENFORCE",
    "NEXT_PUBLIC_SHOW_LIVE_BIDDING_NAV",
    "NEXT_PUBLIC_SENTRY_DSN_WEB",
    "NEXT_PUBLIC_SETTLEMENTS_EMAIL",
    "NEXT_PUBLIC_SETTLEMENTS_PHONE",
    "INTERNAL_API_URL",
    "PLATFORM_CATALOG_LEGAL_ENTITY_ID",
    "SENTRY_DSN_WEB",
    "PLAYWRIGHT_E2E",
    "PLAYWRIGHT_BASE_URL",
    "ENABLE_BULL_BOARD",
    "BULLMQ_OTEL_ENABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}

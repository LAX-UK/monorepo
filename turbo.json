    "XERO_CLIENT_SECRET",
    "XERO_REDIRECT_URI",
    "XERO_WEBHOOK_KEY",
    "XERO_DEFAULT_REVENUE_ACCOUNT_CODE",
    "XERO_DEFAULT_TAX_TYPE",
    "XERO_INVOICE_DUE_DAYS",
    "XERO_USE_LEGAL_ENTITY_CONTACT",

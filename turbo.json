{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "PORT",
    "DATABASE_URL",
    "DATABASE_URL_AUTH",
    "DATABASE_URL_API",
    "REDIS_URL",
    "BETTER_AUTH_SECRET",
    "API_PUBLIC_URL",
    "OIDC_ISSUER_URL",
    "WEB_ORIGIN",
    "COOKIE_DOMAIN",
    "VERIFY_ORIGIN",
    "ALLOW_HTTP_COOKIES",
    "LOG_LEVEL",
    "SENTRY_DSN_API",
    "EMAIL_PROVIDER",
    "EMAIL_FROM",
    "EMAIL_REPLY_TO",
    "POSTMARK_SERVER_TOKEN",
    "POSTMARK_TRANSACTIONAL_STREAM",
    "POSTMARK_BROADCAST_STREAM",
    "POSTMARK_WEBHOOK_BASIC_AUTH",
    "EMAIL_UNSUBSCRIBE_SECRET",
    "REQUIRE_EMAIL_VERIFICATION",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "APPLE_CLIENT_ID",

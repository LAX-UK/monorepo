{
  "name": "auction",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:ui-guardrails": "bash ./scripts/check-ui-guardrails.sh",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "db:generate": "pnpm --filter @auction/db db:generate",
    "db:migrate": "pnpm --filter @auction/db db:migrate",
    "db:migrate:prod": "pnpm --filter @auction/db db:migrate:prod",
    "db:migrate:docker": "docker compose exec -T api node packages/db/dist/migrate.js",
    "db:seed:docker": "docker compose exec -T api node packages/db/dist/seed.js",
    "db:seed:docker:prod": "docker compose -f docker-compose.prod.yml exec -T api node packages/db/dist/seed.js",
    "db:studio": "pnpm --filter @auction/db db:studio",
    "db:seed": "pnpm --filter @auction/db db:seed",
    "test:up": "gh workflow run terraform-test-up.yml",
    "test:down": "gh workflow run terraform-test-down.yml",
    "jwks:snapshot": "tsx scripts/jwks-snapshot.ts",
    "jwks:restore": "tsx scripts/jwks-restore.ts",
    "cost:check": "tsx scripts/check-do-bill.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@biomejs/biome": "^1.9.4",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}

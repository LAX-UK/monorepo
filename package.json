{
  "name": "auction",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:ui-guardrails": "bash ./scripts/check-ui-guardrails.sh",
    "lint:admin-capability-drift": "node scripts/check-admin-capability-drift.mjs",
    "lint:deps": "node scripts/check-circular-deps.mjs && node scripts/ci/check-circular-deps-freeze.mjs",
    "lint:layers": "node scripts/check-layers.mjs",
    "lint:web-guardrails": "node scripts/check-web-guardrails.mjs",
    "lint:lib-admin-boundaries": "node scripts/check-lib-admin-boundaries.mjs",
    "lint:staff-legacy-shell": "node scripts/check-staff-legacy-shell.mjs",
    "lint:staff-route-composition": "node scripts/check-staff-route-composition.mjs",
    "lint:z-schema-transform": "node scripts/check-z-schema-transform.mjs",
    "lint:e2e-portfolio": "pnpm --filter @auction/web check:e2e-portfolio",
    "lint:e2e-tags": "pnpm --filter @auction/web check:e2e-tags",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:docker": "bash scripts/docker-test.sh",
    "ci:verify": "pnpm exec biome check . && pnpm lint:ui-guardrails && pnpm lint:admin-capability-drift && pnpm lint:deps && pnpm lint:layers && pnpm lint:web-guardrails && pnpm lint:lib-admin-boundaries && pnpm lint:staff-legacy-shell && pnpm lint:staff-route-composition && pnpm lint:z-schema-transform && pnpm lint:e2e-portfolio && pnpm lint:e2e-tags && node scripts/lint-queue-registry.mjs && pnpm ci:identity-boundary && pnpm ci:identity-extractability && pnpm ci:identity-exit-criteria && pnpm turbo run lint && pnpm turbo run typecheck && pnpm turbo run test && pnpm turbo run build && node scripts/check-email-assets.mjs",
    "ci:identity-boundary": "node scripts/ci/verify-identity-boundary.mjs",
    "ci:identity-extractability": "node scripts/ci/verify-identity-extractability.mjs",
    "ci:identity-exit-criteria": "node scripts/ci/verify-identity-exit-criteria.mjs",
    "ci:pr-local": "node scripts/ci/run-pr-ci-local.mjs",
    "ci:release-gates": "node scripts/ci/run-local-release-gates.mjs",
    "ci:classify-tree": "node scripts/ci/classify-working-tree.mjs",
    "ci:backup-ref": "node scripts/ci/create-release-backup-ref.mjs",
    "ci:record-evidence": "node scripts/ci/record-release-evidence.mjs",
    "ci:staging-acceptance": "node scripts/ci/run-staging-acceptance-preflight.mjs",
    "ci:authorize-cutover": "node scripts/ci/authorize-cutover-preflight.mjs",
    "ci:prove-release": "pnpm ci:verify && pnpm ci:release-gates && pnpm ci:record-evidence",
    "ci:e2e-pr": "node scripts/ci/run-pr-browser-gates.mjs",
    "ci:pre-push": "pnpm exec biome check . && node --test scripts/ci/e2e-session-state.test.mjs && pnpm lint:lib-admin-boundaries && pnpm lint:staff-legacy-shell && pnpm lint:staff-route-composition && pnpm lint:e2e-portfolio && pnpm lint:e2e-tags && REDIS_URL=${REDIS_URL:-redis://127.0.0.1:6379} pnpm ci:release-gates",
    "ci:visual-baseline": "node scripts/ci/update-visual-baselines.mjs",
    "ci:staging-preflight": "node scripts/ci/staging-cutover-preflight.mjs",
    "ci:perf": "pnpm --filter @auction/web build && pnpm exec lhci autorun --config=./lighthouserc.json",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "db:generate": "pnpm --filter @auction/db db:generate",
    "db:migrate": "pnpm --filter @auction/db db:migrate",
    "db:migrate:prod": "pnpm --filter @auction/db db:migrate:prod",
    "db:migrate:docker": "docker compose run --rm migrate",
    "db:seed:docker": "docker compose run --rm migrate node packages/db/dist/seed/runners/cli.js",
    "db:seed:docker:prod": "docker compose -f docker-compose.prod.yml exec -T api node packages/db/dist/seed/runners/cli.js",
    "db:studio": "pnpm --filter @auction/db db:studio",
    "db:seed": "pnpm --filter @auction/db db:seed:dev",
    "test:up": "gh workflow run terraform-test-up.yml",
    "test:down": "gh workflow run terraform-test-down.yml",
    "jwks:snapshot": "tsx scripts/jwks-snapshot.ts",
    "jwks:restore": "tsx scripts/jwks-restore.ts",
    "gen:apple-secret": "tsx scripts/generate-apple-client-secret.ts",
    "cost:check": "tsx scripts/check-do-bill.ts",
    "audit:dark-mode": "tsx apps/web/src/lib/theme/audit-dark-mode.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@biomejs/biome": "^1.9.4",
    "@lhci/cli": "^0.14.0",
    "@types/pg": "^8.11.10",
    "jose": "^6.2.3",
    "madge": "^8.0.0",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}

{
  "enforce": false,
  "apps": {
    "apps/web": {
      "fallback": "public",
      "ignore": ["^/admin", "^/dev/", "^/display/"],
      "groups": {
        "public": {
          "budgetKb": 451,
          "enforce": true,
          "match": []
        },
        "sale": {
          "budgetKb": 560,
          "enforce": true,
          "match": ["^/\\(marketing\\)/sales/\\[slug\\]/\\[id\\]"]
        },
        "listing": {
          "budgetKb": 525,
          "enforce": true,
          "match": [
            "^/\\(marketing\\)/(search|artists|press)$",
            "^/\\(marketing\\)/(artists|sales/\\(index\\))"
          ]
        },
        "lot": {
          "budgetKb": 545,
          "enforce": true,
          "match": ["^/\\(marketing\\)/(lot|artist)/"]
        },
        "checkout": {
          "budgetKb": 544,
          "match": ["^/\\(client\\)/purchases/(checkout|pay|collect)"]
        },
        "account": {
          "budgetKb": 626,
          "match": ["^/\\((client|task)\\)/"]
        }
      },
      "requireSentry": true
    },
    "apps/shop": {
      "fallback": "public",
      "ignore": [],
      "groups": {
        "public": {
          "budgetKb": 571,
          "match": []
        },
        "product": {
          "budgetKb": 606,
          "match": ["^/(artworks|merchandise)/\\[slug\\]$"]
        },
        "checkout": {
          "budgetKb": 605,
          "match": ["^/(basket|checkout)"]
        },
        "account": {
          "budgetKb": 571,
          "match": [
            "^/(account|login|register|signed-out|session-expired|sign-in-error|orders/guest)"
          ]
        }
      },
      "requireSentry": true
    },
    "apps/art": {
      "fallback": "public",
      "ignore": [],
      "groups": {
        "public": {
          "budgetKb": 579,
          "match": []
        },
        "product": {
          "budgetKb": 575,
          "match": ["^/(artworks|artists)/\\[slug\\]$"]
        },
        "account": {
          "budgetKb": 573,
          "match": ["^/(account|login|register|signed-out|session-expired|sign-in-error)"]
        }
      },
      "requireSentry": true
    },
    "apps/account": {
      "fallback": "account",
      "ignore": [],
      "groups": {
        "account": {
          "budgetKb": 375,
          "match": []
        }
      }
    }
  }
}
